{
  "name": "chiffra-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch .env --ext ts,json --exec tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "nodemon --watch src --watch .env --ext ts,json --exec tsx src/worker/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/websocket": "^10.0.1",
    "@langchain/core": "^0.3.17",
    "@langchain/langgraph": "^0.2.19",
    "@langchain/openai": "^0.3.14",
    "bullmq": "^5.28.2",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pdf-to-img": "^5.0.0",
    "pdfjs-dist": "^5.4.0",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
